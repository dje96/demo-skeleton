# ─── Snowplow Console (server-only — Signals Node SDK / Signals Inspector) ───
# From Console → API keys. Used by src/lib/signals-server.ts.
SNOWPLOW_CONSOLE_API_KEY_ID=[YOUR-CONSOLE-API-KEY-ID]
SNOWPLOW_CONSOLE_API_KEY=[YOUR-CONSOLE-API-KEY]
SNOWPLOW_CONSOLE_ORG_ID=[YOUR-CONSOLE-ORG-ID]

# ─── Snowplow Signals API host (per-pipeline) ───────────────────────────────
# Server-side (Signals Node SDK). Either name is accepted by signals-server.ts.
SIGNALS_API_URL=https://[your-pipeline].signals.snowplowanalytics.com
# Browser-exposed copy — the interventions SSE host for the Signals browser plugin.
NEXT_PUBLIC_SNOWPLOW_SIGNALS_API_URL=https://[your-pipeline].signals.snowplowanalytics.com
